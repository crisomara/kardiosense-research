# Separate pinned environment for 05_export_tflite.ipynb only.
# Kept out of the main Dockerfile because TensorFlow + ONNX's CUDA/cuDNN
# requirements conflict with the PyTorch image's pairing -- forcing both
# stacks into one image risks silent, hard-to-debug version conflicts.
FROM tensorflow/tensorflow:2.16.1

WORKDIR /workspace

# Pinned in requirements-export.txt; tensorflow==2.16.1 there matches this
# base image, so pip leaves it as it is.
COPY requirements-export.txt /tmp/requirements-export.txt
RUN pip install --no-cache-dir \
    jupyter==1.0.0 \
    nbconvert==7.16.4 \
    -r /tmp/requirements-export.txt

COPY notebooks/05_export_tflite.ipynb /workspace/notebooks/

EXPOSE 8888
CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
