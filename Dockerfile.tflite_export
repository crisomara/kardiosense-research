# Separate pinned environment for 05_export_tflite.ipynb only.
# Kept out of the main Dockerfile because TensorFlow's CUDA/cuDNN
# requirements conflict with the PyTorch image's pairing, and forcing both
# stacks into one image risks silent, hard-to-debug version conflicts.
FROM python:3.14.9-slim-bookworm

WORKDIR /workspace

# All pins are in requirements-export.txt. torch comes from the PyTorch CPU
# index first, so the export image carries no CUDA libraries; the torch pin
# in requirements-export.txt is then already satisfied.
COPY requirements-export.txt /tmp/requirements-export.txt
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.14.1 \
    && pip install --no-cache-dir -r /tmp/requirements-export.txt

COPY notebooks/05_export_tflite.ipynb /workspace/notebooks/

EXPOSE 8888
CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
